{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "800px", "wideSize": "1400px" },
    "color": {
      "background": true,
      "text": true,
      "link": true,
      "palette": [
        { "slug": "void", "name": "Void Black", "color": "#0B0C10" },
        { "slug": "charcoal", "name": "Charcoal", "color": "#12141A" },
        { "slug": "slate-t", "name": "Temple Slate", "color": "#1A1D26" },
        { "slug": "indigo-t", "name": "Shani Indigo", "color": "#0F1A2E" },
        { "slug": "gold", "name": "Antique Gold", "color": "#D4AF37" },
        { "slug": "gold-light", "name": "Radiant Gold", "color": "#E5C158" },
        { "slug": "ivory", "name": "Warm Ivory", "color": "#F6F4EE" },
        { "slug": "muted-ivory", "name": "Muted Ivory", "color": "#B0B7C3" },
        { "slug": "saffron", "name": "Sacred Saffron", "color": "#E07A2C" }
      ]
    },
    "typography": {
      "fontFamilies": [
        { "slug": "cinzel", "name": "Cinzel", "fontFamily": "'Cinzel', 'Cormorant Garamond', serif" },
        { "slug": "outfit", "name": "Outfit", "fontFamily": "'Outfit', system-ui, sans-serif" },
        { "slug": "rozha", "name": "Rozha One", "fontFamily": "'Rozha One', 'Tiro Devanagari Hindi', serif" },
        { "slug": "noto-devanagari", "name": "Noto Devanagari", "fontFamily": "'Noto Sans Devanagari', sans-serif" },
        { "slug": "tiro", "name": "Tiro Devanagari", "fontFamily": "'Tiro Devanagari Hindi', 'Rozha One', serif" }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "medium", "name": "Medium", "size": "1rem" },
        { "slug": "large", "name": "Large", "size": "1.25rem" },
        { "slug": "x-large", "name": "X-Large", "size": "clamp(1.75rem, 4vw, 3rem)" },
        { "slug": "hero", "name": "Hero", "size": "clamp(3rem, 7vw, 5.5rem)" }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "vh", "vw", "%"],
      "spacingScale": { "steps": 7 }
    }
  },
  "styles": {
    "color": { "background": "#0B0C10", "text": "#F6F4EE" },
    "typography": { "fontFamily": "'Outfit', 'Noto Sans Devanagari', system-ui, sans-serif", "lineHeight": "1.6" },
    "elements": {
      "link": { "color": { "text": "#D4AF37" } },
      "h1": { "typography": { "fontFamily": "'Cinzel', serif", "lineHeight": "1.1" }, "color": { "text": "#F6F4EE" } },
      "h2": { "typography": { "fontFamily": "'Cinzel', serif" }, "color": { "text": "#F6F4EE" } },
      "h3": { "typography": { "fontFamily": "'Cinzel', serif" }, "color": { "text": "#F6F4EE" } },
      "button": {
        "color": { "background": "#D4AF37", "text": "#0B0C10" },
        "border": { "radius": "999px" },
        "typography": { "textTransform": "uppercase", "letterSpacing": "0.06em", "fontSize": "12px", "fontWeight": "600" },
        "spacing": { "padding": { "top": "12px", "bottom": "12px", "left": "26px", "right": "26px" } }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-donate", "title": "Donate", "postTypes": ["page"] },
    { "name": "page-live-darshan", "title": "Live Darshan", "postTypes": ["page"] }
  ]
}
